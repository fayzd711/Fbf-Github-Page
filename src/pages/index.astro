---
import galleryItems from "../data/gallery.json";
import "../styles/global.css";

const siteTitle = "Found by Fay";
const siteDescription =
  "Found by Fay is a visual archive of aesthetic finds, references, and notes.";
const canonicalUrl = "https://fayzd711.github.io/Fbf-Github-Page/";
const basePath = import.meta.env.BASE_URL;
const normalizedBasePath = basePath.endsWith("/") ? basePath : `${basePath}/`;
const withBase = (path: string) => (path ? `${normalizedBasePath}${path.replace(/^\//, "")}` : "");
const serializedItems = JSON.stringify(
  galleryItems.map((item) => ({
    ...item,
    image: withBase(item.image),
  })),
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={siteDescription} />
    <meta name="theme-color" content="#f7f3ee" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content="A quiet visual archive of finds and references." />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${canonicalUrl}assets/hero.png`} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={withBase("/assets/favicon.svg")} type="image/svg+xml" />
    <script id="gallery-data" type="application/json" set:html={serializedItems} />
    <script src={withBase("/scripts/gallery.js")} defer></script>
    <title>{siteTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="header-main">
        <a class="brand-mark" href="#top" aria-label="Found by Fay home">F</a>
        <a class="home-link" href="#top">Home feed</a>
        <button class="menu-button" type="button" aria-label="Menu">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>

      <a class="profile-pill" href="#top" aria-label="Found by Fay profile">
        <span class="profile-avatar" aria-hidden="true">F</span>
        <span>found by fay</span>
      </a>

      <div class="header-actions" aria-label="Gallery tools">
        <button type="button" aria-label="Search"></button>
        <button type="button" aria-label="Notifications"></button>
        <button type="button" aria-label="Messages"></button>
      </div>
    </header>

    <main id="top">
      <section class="intro" aria-labelledby="page-title">
        <h1 id="page-title">Found by Fay</h1>
        <nav class="topic-nav" aria-label="Gallery categories">
          <a href="#top" aria-current="page">All</a>
          <a href="#top">Mood</a>
          <a href="#top">Wardrobe</a>
          <a href="#top">Accessories</a>
          <a href="#top">Interior Design</a>
          <a href="#top">Exterior Design</a>
          <a href="#top">Silhouettes</a>
          <a href="#top">Celebrations</a>
          <a href="#top">Store Concepts</a>
        </nav>
      </section>

      <section class="gallery-shell" aria-labelledby="gallery-title">
        <div class="gallery-heading">
          <h2 id="gallery-title">All</h2>
          <p id="gallery-count" aria-live="polite">Loading gallery.</p>
        </div>
        <div class="masonry" id="gallery" aria-live="polite"></div>
        <div class="load-sentinel" id="load-sentinel" aria-hidden="true"></div>
        <button class="load-more" id="load-more" type="button">Load more</button>
      </section>
    </main>

    <footer class="site-footer">
      <p>
        Found by Fay may use affiliate links. If you buy through one of those
        links, Fay may earn a small commission at no extra cost to you.
      </p>
    </footer>

    <dialog class="detail-modal" id="detail-modal" aria-labelledby="modal-title">
      <button class="modal-close" type="button" data-close-modal aria-label="Close detail view">
        <span aria-hidden="true">&times;</span>
      </button>
      <div class="modal-media" id="modal-media"></div>
      <div class="modal-copy">
        <p class="modal-type" id="modal-type"></p>
        <h2 id="modal-title"></h2>
        <p id="modal-description"></p>
        <p class="modal-credit" id="modal-credit"></p>
        <p class="modal-disclosure" id="modal-disclosure"></p>
        <div class="modal-actions" id="modal-actions"></div>
      </div>
    </dialog>
  </body>
</html>
